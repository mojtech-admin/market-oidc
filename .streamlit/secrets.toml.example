# DO NOT commit a real secrets.toml file.
# Configure these values in Streamlit Community Cloud -> App settings -> Secrets.

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[supabase]
url = "https://YOUR_PROJECT.supabase.co"
service_role_key = "REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"

# Proprietary values are intentionally omitted from the repository.
# Enter the private numeric values directly in Streamlit Secrets.
[proprietary]
growth_sp500 = "PRIVATE"
growth_qqq = "PRIVATE"
growth_stock = "PRIVATE"
general_sp500 = "PRIVATE"
general_qqq = "PRIVATE"
general_stock = "PRIVATE"
spy_sp500 = "PRIVATE"
spy_qqq = "PRIVATE"
spy_stock = "PRIVATE"
voo_sp500 = "PRIVATE"
voo_qqq = "PRIVATE"
voo_stock = "PRIVATE"
qqq_sp500 = "PRIVATE"
qqq_qqq = "PRIVATE"
qqq_stock = "PRIVATE"
other_etf_sp500 = "PRIVATE"
other_etf_qqq = "PRIVATE"
other_etf_stock = "PRIVATE"
green_threshold = "PRIVATE"
red_threshold = "PRIVATE"
